# Network: hideki is the dreamDEX perps testnet (Somnia Tokyo, chain 50383)
NETWORK=hideki
# 32 random bytes as hex. Encrypts the per-follow bot keys at rest. Generate: openssl rand -hex 32
MASTER_KEY=
# Where follows and mirror records are kept
DATA_DIR=data
# How far past the mark a mirror order may fill, in basis points
SLIPPAGE_BPS=75
# Safety brake per follow against a hyperactive leader
MAX_ORDERS_PER_HOUR=60
# Only for scripts/: a funded testnet key
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
PORT=8790
