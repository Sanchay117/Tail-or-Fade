{
  "name": "tail-or-fade",
  "version": "0.1.0",
  "private": true,
  "description": "Tail or fade any dreamDEX perps trader. Mirrors their position changes into your account via Somnia Reactivity.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run api\" \"npm run web\"",
    "start": "tsx src/server.ts",
    "build": "vite build --config web/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "api": "tsx src/server.ts",
    "web": "vite --config web/vite.config.ts --port 5195 --strictPort"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@somnia-chain/markets-sdk": "0.32.1",
    "@somnia-chain/reactivity": "^0.2.1",
    "dotenv": "^18.0.10",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
